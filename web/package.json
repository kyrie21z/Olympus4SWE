{
  "name": "ariadne-web",
  "private": true,
  "version": "0.2.0",
  "description": "Ariadne console: React 19 + TypeScript SPA built into src/olympus/web/static/",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../src/olympus/web/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.2",
    "elkjs": "^0.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
